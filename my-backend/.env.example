# Порт сервера (Render назначает PORT автоматически)
PORT=3000

# Telegram Bot API Token от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Google Gemini API Key для генерации SEO-текстов и инфографики
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Данные кассы Click.uz (для приема сумовых платежей в Узбекистане)
CLICK_MERCHANT_ID=12345
CLICK_SERVICE_ID=67890
CLICK_SECRET_KEY=YourClickSecretKeyHere

# Ссылка на развернутый фронтенд (для WebApp кнопок в боте)
FRONTEND_URL=https://your-frontend-domain.onrender.com
